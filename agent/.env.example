# Copy to .env and fill in as needed. Never commit the real .env file.

# --- OpenRouter (optional AI classification layer) ---
# Scanning works fully with AI_ENABLED=false — AI is never required for detection.
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Backend connection (optional; agent can run fully offline) ---
DATASENTINEL_BACKEND_URL=
DATASENTINEL_ENDPOINT_TOKEN=

# --- Local storage ---
DATASENTINEL_DB_PATH=./datasentinel.db

# --- Scheduling (optional; defaults to ~/.datasentinel/schedules.json) ---
DATASENTINEL_SCHEDULES_PATH=

# --- Logging ---
DATASENTINEL_LOG_LEVEL=INFO
