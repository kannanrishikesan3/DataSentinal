# Copy to .env (in this docker/ directory) and fill in real values.
# Never commit the real .env file. docker-compose.yml reads these both for
# variable substitution (${VAR}) and, for the backend services, as the
# container's actual runtime environment (via `env_file: .env`).

# --- Postgres (compose-managed container) ---
POSTGRES_USER=datasentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datasentinel

# --- Backend (see ../backend/.env.example for the full reference) ---
DATASENTINEL_ENV=development

# Hostname must be the compose service name ("postgres"), not localhost —
# containers reach each other by service name on the compose network. User,
# password, and db here must match POSTGRES_USER/PASSWORD/DB above.
DATASENTINEL_DATABASE_URL=postgresql+psycopg://datasentinel:change-me@postgres:5432/datasentinel

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATASENTINEL_SECRET_KEY=

DATASENTINEL_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated origins allowed to call the API. Include the frontend's
# published origin (e.g. http://localhost:5173 for the default compose port
# mapping below).
DATASENTINEL_CORS_ORIGINS=http://localhost:5173

DATASENTINEL_LOG_LEVEL=INFO

# --- Frontend (see ../frontend/.env.example) ---
# Vite bakes this into the static bundle at build time (not read at
# container runtime) — changing it requires `docker compose up --build
# frontend` again.
VITE_API_BASE_URL=http://localhost:8000
