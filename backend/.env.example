# Copy to .env and fill in as needed. Never commit the real .env file.

DATASENTINEL_ENV=development

# --- Database ---
DATASENTINEL_DATABASE_URL=postgresql+psycopg://datasentinel:datasentinel@localhost:5432/datasentinel

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATASENTINEL_SECRET_KEY=
DATASENTINEL_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated origins allowed to call the API) ---
DATASENTINEL_CORS_ORIGINS=http://localhost:5173

# --- Logging ---
DATASENTINEL_LOG_LEVEL=INFO
